<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
   elementFormDefault="qualified"
   attributeFormDefault="unqualified">
  <xs:annotation>
    <xs:documentation xml:lang="en">
      Saved Form answers for ZATS Test Case list.
    </xs:documentation>
  </xs:annotation>
  
    <xs:element name="TestCaseListSelection">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" name="Selections" type="Selection" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
    <xs:complexType name="Selection">
    <xs:attribute name="TriggerId" type="xs:string"></xs:attribute>
    <xs:attribute name="TriggerValueId" type="xs:string"></xs:attribute>
  </xs:complexType>
  
  </xs:schema>