<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
   elementFormDefault="qualified"
   attributeFormDefault="unqualified">
  <xs:annotation>
    <xs:documentation xml:lang="en">
      ZATS Test Case list for DUT based CTT projects.
    </xs:documentation>
  </xs:annotation>

  <xs:element name="ZatsTestCaseList">
    <xs:complexType>
      <xs:sequence>
        <xs:element minOccurs="0" maxOccurs="unbounded" name="ZatsTestTrigger" type="ZatsTestCaseTriggerDef" />
        <xs:element maxOccurs="unbounded" name="ZatsTestCase" type="ZatsTestCase" />
      </xs:sequence>
      <xs:attribute name="ZWPVersion" use="required" type="ZWPVersion"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="ZatsTestCaseTriggerDef">
    <xs:sequence>
      <xs:element minOccurs="0" name="Description" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="TriggerValue" type="TriggerValueDef" />
    </xs:sequence>
    <xs:attribute name="Type" type="TriggerType"/>
    <xs:attribute name="TriggerId" type="xs:ID"></xs:attribute>
  </xs:complexType>

  <xs:complexType name="TriggerValueDef">
    <xs:attribute name="TriggerValue" type="xs:string"></xs:attribute>
    <xs:attribute name="TriggerValueId" type="xs:ID"></xs:attribute>
  </xs:complexType>

  <xs:complexType name="ZatsTestCaseTriggerRef">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="TriggerValueId" type="xs:IDREF" />
    </xs:sequence>
    <xs:attribute name="TriggerId" type="xs:IDREF"></xs:attribute>
  </xs:complexType>

  <xs:complexType name="ZatsTestCase">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="InterviewFilter" type="ZatsTestCaseFilter" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="UserTrigger" type="ZatsTestCaseTriggerRef" />
    </xs:sequence>
    <xs:attribute name="Name" type="xs:token" use="required" />
  </xs:complexType>

  <xs:complexType name="ZatsTestCaseFilter">
    <xs:sequence>
      <xs:element maxOccurs="unbounded" name="Value" type="xs:string" />
    </xs:sequence>
    <xs:attribute name="Type" use="required" type="FilterType"/>
  </xs:complexType>

  <xs:simpleType name="ZWPVersion">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Z-Wave Plus"/>
      <xs:enumeration value="Z-Wave Plus v2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FilterType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DeviceType"/>
      <xs:enumeration value="RoleType"/>
      <xs:enumeration value="SupportedCommandClass"/>
      <xs:enumeration value="SecurityClass"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TriggerType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ValueSelect"/>
      <xs:enumeration value="Checkbox"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
