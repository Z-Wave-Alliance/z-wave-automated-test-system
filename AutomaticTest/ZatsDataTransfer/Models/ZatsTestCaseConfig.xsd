<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
   elementFormDefault="qualified"
   attributeFormDefault="unqualified">
  <xs:element name="ZatsTestCaseConfig">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="EndPoint">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="0"/>
              <xs:maxInclusive value="127"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="DSK" type="xs:string" />
        <xs:element name="DUT_NodeId" type="xs:unsignedByte" />
        <xs:element name="OTAUpdateFile" type="xs:string" />
        <xs:element name="InitS2SeqNo" type="xs:unsignedByte" minOccurs="0" maxOccurs="1" />
        <xs:element name="PortalUrl" type="xs:string" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
</xs:schema>